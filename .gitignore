# 의존성 · 빌드 산출물
node_modules/
web/node_modules/
dist/
web/dist/
coverage/
web/coverage/

# 파이썬
__pycache__/
*.pyc
.venv/

# OS · 에디터
.DS_Store
*.log
# AI 코딩 도구의 PC별 로컬 설정(권한 허용목록 등) — 사람마다 다르다
.claude/settings.local.json

# 런타임 수집 데이터(개인/의료 라벨 데이터일 수 있어 커밋 금지)
feedback/*.jsonl
feedback/images/*
webjobs/

# (2026-09-02) 피드백·보관함 API 모두 인증이 없어져 이 파일은 더 이상 쓰지
# 않는다. 남아 있어도 무시된다.
private/.library-password

# 생성 산출물·비공개 케이스(실물 라벨 이미지)는 저장소에 넣지 않는다
bench/out/
# 합성 케이스 이미지 캐시(레시피에서 언제든 재생성된다)
bench/work/
# private/ 전체는 커밋하지 않는다 — 실물 라벨 이미지(의료기기 데이터)와
# 인수인계 계정 시트가 들어간다.
private/
# 단, 안전망의 계약·기준선·이력은 반드시 커밋한다(코드와 함께 버전 관리돼야
# 회귀를 커밋에 붙일 수 있다): bench/cases/, bench/baseline.json,
# bench/history.jsonl
