<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 03:10 정확도 안전망 자동 점검. 설치:
       cp tools/com.artwork-compare.bench-sync.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.artwork-compare.bench-sync.plist
     즉시 한 번 돌리기:  launchctl kickstart -k gui/$(id -u)/com.artwork-compare.bench-sync
     끄기:              launchctl bootout gui/$(id -u)/com.artwork-compare.bench-sync -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.artwork-compare.bench-sync</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 서버 에이전트와 같은 바이너리를 쓴다: /bin/sh 로 실행하면 launchd 가
         ~/Desktop 접근을 막혀(macOS TCC) "Operation not permitted" 로 죽는다. -->
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/reliability/.pyenv/versions/3.11.9/bin/python3</string>
    <string>-m</string>
    <string>bench.sync</string>
  </array>
  <!-- launchd 의 PATH 는 최소라 tesseract(/opt/homebrew/bin)가 안 보인다.
       그대로 두면 OCR 경로가 통째로 빠진 채 채점돼 결과가 달라진다. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/reliability/Desktop/dev/i-sens/print-compare</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <!-- 03:10에 꺼져 있었다면 켜진 뒤 한 번 따라잡는다 -->
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/reliability/Library/Logs/artwork-compare-bench.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/reliability/Library/Logs/artwork-compare-bench.log</string>
</dict>
</plist>
